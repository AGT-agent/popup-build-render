{
  "name": "popup-build-render",
  "version": "0.4.0-rc.0",
  "type": "module",
  "description": "A JSON-driven popup modal renderer and a visual builder for authoring the JSON.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AGT-agent/popup-build-render.git"
  },
  "license": "UNLICENSED",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "lib",
    "src",
    "README.md",
    "POPUP-COMPONENT-JSON-SCHEMA.md"
  ],
  "main": "./lib/index.js",
  "module": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./builder": {
      "types": "./lib/builder/index.d.ts",
      "default": "./lib/builder.js"
    },
    "./builder.css": "./lib/builder.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run build:lib",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:app": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "prepare": "npm run build:lib",
    "pack:check": "npm pack --dry-run",
    "preversion": "npm run typecheck && npm run build:lib",
    "postversion": "git push --follow-tags",
    "release:rc": "npm version prerelease --preid=rc",
    "release:rc:minor": "npm version preminor --preid=rc",
    "release:rc:major": "npm version premajor --preid=rc",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  },
  "dependencies": {
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^5.0.3"
  }
}
